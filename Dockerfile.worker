FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
COPY apps/backend/package*.json apps/backend/
COPY apps/frontend/package*.json apps/frontend/
COPY apps/telegram-worker/package*.json apps/telegram-worker/
COPY packages packages
COPY tsconfig.base.json ./
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*
RUN npm ci
RUN npm run build --workspace=@invait/contracts
COPY prisma prisma
COPY apps/telegram-worker apps/telegram-worker
RUN npx prisma generate --schema prisma/schema.prisma && npm run build --workspace=@invait/telegram-worker

FROM node:20-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/telegram-worker/dist ./apps/telegram-worker/dist
COPY --from=build /app/apps/telegram-worker/package.json ./apps/telegram-worker/package.json
COPY --from=build /app/packages/contracts ./packages/contracts
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/prisma ./prisma
CMD ["node", "apps/telegram-worker/dist/runtime-entry.js"]
