# Runtime
NODE_ENV=development
LOG_LEVEL=info
BACKEND_PORT=4000
FRONTEND_PORT=3000
DOMAIN=localhost
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# Persistence (required for Prisma migrations and database-backed features)
DATABASE_URL=postgresql://app:change-me@localhost:5432/invait
POSTGRES_DB=invait
POSTGRES_USER=app
POSTGRES_PASSWORD=
REDIS_URL=redis://localhost:6379
TELEGRAM_WORKER_ID=telegram-worker-1
TELEGRAM_WORKER_HEARTBEAT_MS=15000
TELEGRAM_ACCOUNT_LOCK_TTL_MS=60000

# Authentication (generate unique values before deployment)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Telegram credentials (never commit real values)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_ENCRYPTION_KEY=

# Optional bootstrap/notifications
ADMIN_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
